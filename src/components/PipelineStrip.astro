---
import { pipelineGates } from '../data/site';
---

<ol
  aria-label="Pipeline stages, in order"
  class="flex flex-wrap items-center gap-2 font-mono text-[0.8125rem]"
>
  {pipelineGates.map((gate) => (
    <li class="flex items-center gap-2">
      <span class="rounded border border-line-strong bg-surface px-2.5 py-1.5">
        <span class="text-ok" aria-hidden="true">
          ✓{' '}
        </span>
        {gate}
      </span>
      <span class="text-muted" aria-hidden="true">
        →
      </span>
    </li>
  ))}
  <li>
    <span class="rounded border border-accent px-2.5 py-1.5 text-accent">deploy · pages</span>
  </li>
</ol>
