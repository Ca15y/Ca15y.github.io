---
/**
 * Architecture diagram drawn as inline SVG at build time from project frontmatter.
 *
 * The diagram is a top-to-bottom flow of tiers; each tier holds 1–3 nodes side by side.
 * Edges: a single node fans out to (or in from) every node in the next tier; tiers of equal
 * size connect pairwise. Colours come from the theme tokens, so it follows dark/light mode.
 * Screen readers get the whole flow as text through <desc>.
 */
import type { CollectionEntry } from 'astro:content';

type Arch = NonNullable<CollectionEntry<'projects'>['data']['architecture']>;
interface Props {
  id: string;
  architecture: Arch;
}
const { id, architecture } = Astro.props;
const { tiers, caption } = architecture;

// Width follows the widest tier, so a straight single-column flow fits a phone without scrolling.
const maxNodes = Math.max(...tiers.map((t) => t.length));
// Wide diagrams scroll on phones: a labelled <section> makes the scroll area a keyboard-reachable region.
const scrolls = maxNodes > 1;
const Wrapper = scrolls ? 'section' : 'div';
const W = maxNodes === 1 ? 340 : maxNodes === 2 ? 560 : 640;
const GAP_X = 16;
const NODE_H = 58;
const GAP_Y = 46;
const PAD = 2;

type Box = { x: number; y: number; w: number; cx: number } & Arch['tiers'][number][number];

const layout: Box[][] = tiers.map((tier, row) => {
  const n = tier.length;
  const w = Math.min(300, (W - GAP_X * (n - 1)) / n);
  const total = w * n + GAP_X * (n - 1);
  const x0 = (W - total) / 2;
  const y = PAD + row * (NODE_H + GAP_Y);
  return tier.map((node, i) => {
    const x = x0 + i * (w + GAP_X);
    return { ...node, x, y, w, cx: x + w / 2 };
  });
});

type Edge = { x1: number; y1: number; x2: number; y2: number; label?: string; dashed?: boolean };
const edges: Edge[] = [];
for (let r = 1; r < layout.length; r++) {
  const up = layout[r - 1];
  const down = layout[r];
  const link = (a: Box, b: Box) =>
    edges.push({
      x1: a.cx,
      y1: a.y + NODE_H,
      x2: b.cx,
      y2: b.y - 4,
      label: b.via,
      dashed: b.dashed,
    });
  if (down.some((b) => b.from)) down.forEach((b) => (b.from ?? []).forEach((i) => link(up[i], b)));
  else if (up.length === 1) down.forEach((b) => link(up[0], b));
  else if (down.length === 1) up.forEach((a) => link(a, down[0]));
  else if (up.length === down.length) up.forEach((a, i) => link(a, down[i]));
  else link({ ...up[0], cx: W / 2 } as Box, { ...down[0], cx: W / 2 } as Box);
}

const H = PAD * 2 + tiers.length * NODE_H + (tiers.length - 1) * GAP_Y;
const titleId = `${id}-arch-title`;
const descId = `${id}-arch-desc`;
const describe = (n: Arch['tiers'][number][number]) =>
  `${n.via ? `(${n.via}) ` : ''}${n.label}${n.detail ? `: ${n.detail}` : ''}`;
const desc = tiers.map((tier, i) => `Step ${i + 1}: ${tier.map(describe).join('; ')}`).join('. ');
---

<figure class="arch">
  <Wrapper
    class="overflow-x-auto rounded-md border border-line bg-bg p-4 sm:p-6"
    {...(scrolls
      ? { tabindex: 0, 'aria-label': 'Architecture diagram (scrolls sideways on small screens)' }
      : {})}
  >
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-labelledby={`${titleId} ${descId}`}
      class="mx-auto block w-full"
      style={`max-width:${W}px;min-width:${maxNodes === 1 ? 0 : Math.round(W * 0.72)}px`}
    >
      <title id={titleId}>{caption}</title>
      <desc id={descId}>{desc}</desc>
      <defs>
        <marker
          id={`${id}-arrow`}
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" class="arch-arrow"></path>
        </marker>
      </defs>
      {edges.map((e) => (
        <g>
          <line
            x1={e.x1}
            y1={e.y1}
            x2={e.x2}
            y2={e.y2}
            class:list={['arch-edge', e.dashed && 'arch-dashed']}
            marker-end={`url(#${id}-arrow)`}
          />
          {e.label && (
            <text
              x={(e.x1 + e.x2) / 2 + (e.x2 > e.x1 ? 14 : e.x2 < e.x1 ? -14 : 8)}
              y={(e.y1 + e.y2) / 2 - 2}
              text-anchor={e.x2 >= e.x1 ? 'start' : 'end'}
              class="arch-via"
            >
              {e.label}
            </text>
          )}
        </g>
      ))}
      {layout.flat().map((b) => (
        <g>
          <rect
            x={b.x}
            y={b.y}
            width={b.w}
            height={NODE_H}
            rx="6"
            class:list={['arch-node', b.accent && 'arch-accent', b.dashed && 'arch-dashed']}
          />
          <text x={b.cx} y={b.y + (b.detail ? 24 : 34)} text-anchor="middle" class="arch-label">
            {b.label}
          </text>
          {b.detail && (
            <text x={b.cx} y={b.y + 43} text-anchor="middle" class="arch-detail">
              {b.detail}
            </text>
          )}
        </g>
      ))}
    </svg>
  </Wrapper>
  <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>
</figure>

<style>
  .arch-node {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .arch-accent {
    stroke: var(--accent);
  }
  .arch-dashed {
    stroke-dasharray: 5 4;
  }
  .arch-edge {
    stroke: var(--muted);
    stroke-width: 1.25;
  }
  .arch-arrow {
    fill: var(--muted);
  }
  .arch-label {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
  }
  .arch-detail {
    fill: var(--muted);
    font-family: var(--font-sans);
    font-size: 12.5px;
  }
  .arch-via {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
</style>
