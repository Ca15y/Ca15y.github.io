---
import { education } from '../data/site';
---

<ul class="grid gap-4 sm:grid-cols-2">
  {education.map((item) => (
    <li class="rounded-md border border-line bg-surface p-5">
      <p class="font-mono text-[0.8125rem] text-muted">
        {item.kind}
        {item.year && (
          <>
            <span aria-hidden="true"> · </span>
            <time datetime={item.year}>{item.year}</time>
          </>
        )}
      </p>
      <h3 class="mt-2 text-[1.0625rem] font-semibold">{item.title}</h3>
      <p class="mt-0.5 text-[0.9375rem] text-muted">
        {item.org} · {item.detail}
      </p>
    </li>
  ))}
</ul>
