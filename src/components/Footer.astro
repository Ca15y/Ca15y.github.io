---
import Container from './Container.astro';
import { owner } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <Container class="flex flex-col gap-4 py-8 font-mono text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>
      © {year} {owner.name} · {owner.location}
    </p>
    <ul class="flex flex-wrap gap-x-5">
      <li>
        <a
          class="inline-flex min-h-11 items-center text-muted transition-colors hover:text-text"
          href={owner.links.github}
        >
          GitHub
        </a>
      </li>
      <li>
        <a
          class="inline-flex min-h-11 items-center text-muted transition-colors hover:text-text"
          href={owner.links.linkedin}
        >
          LinkedIn
        </a>
      </li>
      <li>
        <a
          class="inline-flex min-h-11 items-center text-muted transition-colors hover:text-text"
          href={`mailto:${owner.email}`}
        >
          Email
        </a>
      </li>
    </ul>
  </Container>
</footer>
