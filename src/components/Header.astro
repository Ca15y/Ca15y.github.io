---
import Container from './Container.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, owner } from '../data/site';
import { url } from '../lib/url';

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.startsWith('#') && path.startsWith(url(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <Container class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
    <a
      href={url()}
      class="font-mono text-sm font-medium text-text no-underline transition-colors hover:text-accent"
    >
      <span class="text-accent" aria-hidden="true">
        ~/
      </span>
      {owner.name.toLowerCase()}
    </a>
    <div class="flex w-full min-w-0 items-center justify-between gap-4 sm:w-auto">
      <nav aria-label="Main">
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 font-mono text-sm">
          {nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="text-muted no-underline transition-colors hover:text-text aria-[current=page]:text-accent"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </Container>
</header>
