---
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { owner, site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  /** Page title; the site name is appended unless this is the home page. */
  title?: string;
  description?: string;
  /** Error pages: no canonical URL and kept out of search results. */
  noindex?: boolean;
  /** Social preview image name, served from /og/<og>.png. */
  og?: string;
  /** Open Graph type: case studies are articles, everything else is a website. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = site.description,
  noindex = false,
  og = 'home',
  ogType = 'website',
} = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(`og/${og}.png`), Astro.site);
const ogAlt = title ? `${title}, by ${owner.name}` : `${owner.name}, ${owner.title}`;

// Latin subset only: the site is English, so the other subsets are never needed.
const fontFaces = `
@font-face {
  font-family: 'Inter Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url(${interLatin}) format('woff2-variations');
}
@font-face {
  font-family: 'JetBrains Mono Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 800;
  src: url(${monoLatin}) format('woff2-variations');
}`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0c0e10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={owner.name} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces} />
    <script is:inline>
      // Apply a saved theme choice before first paint to avoid a flash.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {
        // Storage blocked: fall back to the system theme.
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded bg-accent px-4 py-2 font-mono text-sm text-accent-contrast focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
