---
import BaseLayout from '../layouts/BaseLayout.astro';
// DELIBERATELY BROKEN (gate test, do not merge)
import Missing from '../components/DoesNotExist.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import WhoAmI from '../components/WhoAmI.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PipelineStrip from '../components/PipelineStrip.astro';
import ExperienceList from '../components/ExperienceList.astro';
import SkillGroups from '../components/SkillGroups.astro';
import LabList from '../components/LabList.astro';
import EducationList from '../components/EducationList.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { getCollection } from 'astro:content';
import { owner } from '../data/site';
import { url } from '../lib/url';

// Home shows the DevOps work only; backend/app projects live under "Other work" on /projects/.
const projects = (await getCollection('projects', (p) => p.data.category === 'devops'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const btnBase =
  'inline-flex min-h-11 items-center gap-2 rounded px-4 py-2.5 font-mono text-sm no-underline transition-colors';
---

<BaseLayout>
  <Missing />
  <section aria-labelledby="hero-heading" class="py-16 sm:py-24">
    <Container class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] lg:gap-12">
      <div class="min-w-0">
        <p class="flex flex-wrap gap-x-2 font-mono text-sm text-muted">
          <span>{owner.name}</span>
          <span aria-hidden="true">·</span>
          <span class="text-accent">{owner.title}</span>
        </p>
        <h1
          id="hero-heading"
          class="mt-5 text-[2rem] leading-tight font-semibold tracking-tight text-balance sm:text-5xl lg:text-[2.625rem]"
        >
          I build cloud infrastructure that lives in code and ships through pipelines, not by hand.
        </h1>
        <p class="mt-6 max-w-[65ch] text-lg text-muted">
          Computer Science graduate working with AWS, Terraform, Docker, and GitHub Actions. I care
          about deployments that are repeatable, tested before they go out, and observable once they
          are running. Working toward SRE and infrastructure engineering.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="#projects"
            class:list={[btnBase, 'bg-accent text-accent-contrast hover:opacity-90']}
          >
            See the projects <span aria-hidden="true">→</span>
          </a>
          <a
            href={url('resume.pdf')}
            class:list={[
              btnBase,
              'border border-line-strong text-text hover:border-accent hover:text-accent',
            ]}
          >
            Résumé (PDF)
          </a>
        </div>
        <ul class="mt-6 flex flex-wrap gap-x-6 font-mono text-sm" aria-label="Elsewhere">
          <li>
            <a
              class="inline-flex min-h-11 items-center text-muted transition-colors hover:text-accent"
              href={owner.links.github}
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              class="inline-flex min-h-11 items-center text-muted transition-colors hover:text-accent"
              href={owner.links.linkedin}
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a
              class="inline-flex min-h-11 items-center text-muted transition-colors hover:text-accent"
              href={`mailto:${owner.email}`}
            >
              {owner.email}
            </a>
          </li>
        </ul>
      </div>
      <WhoAmI />
    </Container>
  </section>

  <Section
    id="projects"
    label="ls projects/"
    title="Selected projects"
    lede="Each one is written up as a case study: the problem, what I built, and the trade-offs."
    more={{ href: url('projects/'), text: 'All case studies' }}
  >
    <div class="grid gap-4 md:grid-cols-2">
      {projects.map((project, i) => (
        <ProjectCard project={project} feature={i === 0} />
      ))}
    </div>
  </Section>

  <Section
    id="colophon"
    label="cat colophon.md"
    title="How this site is built"
    lede="Every pull request runs these gates in GitHub Actions. A failing gate blocks the deploy to GitHub Pages."
    more={{ href: url('colophon/'), text: 'Read the colophon' }}
  >
    <PipelineStrip />
  </Section>

  <Section id="experience" label="history" title="Experience">
    <ExperienceList />
  </Section>

  <Section
    id="labs"
    label="ls labs/"
    title="Labs"
    lede="Smaller builds and exercises, each focused on one tool or technique."
    more={{ href: owner.links.github, text: 'More on GitHub' }}
  >
    <LabList />
  </Section>

  <Section id="skills" label="skills --list" title="Skills">
    <SkillGroups />
  </Section>

  <Section id="education" label="education" title="Education and training">
    <EducationList />
  </Section>

  <Section id="contact" label="contact" title="Get in touch">
    <ContactBlock />
  </Section>
</BaseLayout>
