---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Placeholder from '../components/Placeholder.astro';
import { owner } from '../data/site';
import { url } from '../lib/url';

const btnBase =
  'inline-flex items-center gap-2 rounded px-4 py-2.5 font-mono text-sm no-underline transition-colors';
---

<BaseLayout>
  <section aria-labelledby="hero-heading" class="py-20 sm:py-28">
    <Container>
      <p class="flex flex-wrap gap-x-2 font-mono text-sm text-muted">
        <span>{owner.name}</span>
        <span aria-hidden="true">·</span>
        <span class="text-accent">{owner.title}</span>
      </p>
      <h1
        id="hero-heading"
        class="mt-5 max-w-3xl text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl"
      >
        I build cloud infrastructure that lives in code and ships through pipelines, not by hand.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        Computer Science graduate working with AWS, Terraform, Docker, and GitHub Actions. I care
        about deployments that are repeatable, tested before they go out, and observable once they
        are running. Working toward SRE and infrastructure engineering.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="#projects"
          class:list={[btnBase, 'bg-accent text-accent-contrast hover:opacity-90']}
        >
          See the projects <span aria-hidden="true">→</span>
        </a>
        <a
          href={url('resume.pdf')}
          class:list={[
            btnBase,
            'border border-line-strong text-text hover:border-accent hover:text-accent',
          ]}
        >
          Résumé (PDF)
        </a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm" aria-label="Elsewhere">
        <li>
          <a class="text-muted transition-colors hover:text-accent" href={owner.links.github}>
            GitHub
          </a>
        </li>
        <li>
          <a class="text-muted transition-colors hover:text-accent" href={owner.links.linkedin}>
            LinkedIn
          </a>
        </li>
        <li>
          <a class="text-muted transition-colors hover:text-accent" href={`mailto:${owner.email}`}>
            {owner.email}
          </a>
        </li>
      </ul>
    </Container>
  </section>

  <Section id="projects" label="projects" title="Selected projects">
    <Placeholder note="Phase 2: three case-study cards (flask-cicd-pipeline, afrimart, lirs-document-app)." />
  </Section>

  <Section id="colophon" label="cat colophon" title="How this site is built">
    <Placeholder note="Phase 2/4: short teaser linking to /colophon/." />
  </Section>

  <Section id="experience" label="experience" title="Experience">
    <Placeholder note="Phase 2: LIRS (NYSC), Bloomy Technologies, Digital Bridge Institute." />
  </Section>

  <Section id="labs" label="labs" title="Labs">
    <Placeholder note="Phase 2: pinned GitHub repositories, pending owner approval." />
  </Section>

  <Section id="skills" label="skills" title="Skills">
    <Placeholder note="Phase 2: skills grouped by area." />
  </Section>

  <Section id="education" label="education" title="Education and training">
    <Placeholder note="Phase 2: BSc Computer Science (Babcock), AWS Cloud Practitioner Essentials (course)." />
  </Section>

  <Section id="contact" label="contact" title="Get in touch">
    <Placeholder note="Phase 2: availability statement, email, LinkedIn, GitHub, résumé." />
  </Section>
</BaseLayout>
