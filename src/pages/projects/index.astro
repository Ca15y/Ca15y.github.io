---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects" description="Case studies of cloud, DevOps and automation work.">
  <Container class="py-16 sm:py-20">
    <SectionLabel text="ls projects/" />
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Projects</h1>
    <p class="mt-3 max-w-[60ch] text-muted">
      Each project is written up as a case study: the problem, what I built, the decisions and
      trade-offs, and what I would do next.
    </p>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {projects.map((project, i) => (
        <ProjectCard project={project} feature={i === 0} headingLevel="h2" />
      ))}
    </div>
  </Container>
</BaseLayout>
