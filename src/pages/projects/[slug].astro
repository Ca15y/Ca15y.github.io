---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import { inlineCode } from '../../lib/inline';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const {
  title,
  summary,
  headlineFacts,
  stack,
  links,
  status,
  problem,
  architecture,
  decisions,
  next,
  note,
} = project.data;
const { Content } = await render(project);

const statusText = {
  'not-live': 'Not live right now. The code is on GitHub.',
  internal: 'Internal tool.',
  live: 'Live.',
}[status];

const h2 = 'text-xl font-semibold tracking-tight sm:text-2xl';
const sectionCls = 'mt-14 scroll-mt-24';
const pending = 'rounded-md border border-dashed border-line-strong px-5 py-4 text-muted';
---

<BaseLayout title={title} description={summary}>
  <Container class="py-16 sm:py-20">
    <a
      href={url('projects/')}
      class="inline-flex min-h-11 items-center font-mono text-sm text-muted transition-colors hover:text-accent"
    >
      <span aria-hidden="true">←&nbsp;</span>All projects
    </a>

    <article class="mt-6 max-w-3xl">
      <header>
        <SectionLabel text={`cat ${project.id}.md`} />
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h1>
        <p class="mt-3 font-mono text-sm text-muted">{statusText}</p>
        <p class="mt-5 text-lg">{summary}</p>
        <ul class="mt-6 grid gap-2" aria-label="Headline facts">
          {headlineFacts.map((fact) => (
            <li class="flex gap-2.5">
              <span class="font-mono text-accent" aria-hidden="true">
                →
              </span>
              {fact}
            </li>
          ))}
        </ul>
      </header>

      <section aria-labelledby="problem" class={sectionCls}>
        <h2 id="problem" class={h2}>
          Problem
        </h2>
        <p class="mt-4 text-muted">{problem}</p>
      </section>

      <section aria-labelledby="architecture" class={sectionCls}>
        <h2 id="architecture" class={h2}>
          Architecture
        </h2>
        <div class="mt-5">
          <ArchitectureDiagram id={project.id} architecture={architecture} />
        </div>
      </section>

      <section aria-labelledby="built" class={sectionCls}>
        <h2 id="built" class={h2}>
          What I built
        </h2>
        <div class="prose-case mt-4">
          <Content />
        </div>
      </section>

      <section aria-labelledby="decisions" class={sectionCls}>
        <h2 id="decisions" class={h2}>
          Decisions and trade-offs
        </h2>
        {decisions.length > 0 ? (
          <dl class="mt-4 grid gap-5">
            {decisions.map((d) => (
              <div class="border-l-2 border-line-strong pl-4">
                <dt class="font-medium" set:html={inlineCode(d.decision)} />
                <dd class="mt-1 text-muted" set:html={inlineCode(d.why)} />
              </div>
            ))}
          </dl>
        ) : (
          <p class:list={['mt-4', pending]}>Notes on the trade-offs are being written up.</p>
        )}
      </section>

      <section aria-labelledby="next" class={sectionCls}>
        <h2 id="next" class={h2}>
          What I would do next
        </h2>
        {next.length > 0 ? (
          <ul class="prose-case mt-4">
            {next.map((item) => (
              <li set:html={inlineCode(item)} />
            ))}
          </ul>
        ) : (
          <p class:list={['mt-4', pending]}>Next steps are being written up.</p>
        )}
      </section>

      <section aria-labelledby="stack" class={sectionCls}>
        <h2 id="stack" class={h2}>
          Stack
        </h2>
        <ul class="mt-4 flex flex-wrap gap-2 font-mono text-[0.8125rem]">
          {stack.map((s) => (
            <li class="rounded border border-line-strong px-2.5 py-1">{s}</li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="links" class={sectionCls}>
        <h2 id="links" class={h2}>
          Links
        </h2>
        <ul class="mt-3 flex flex-wrap gap-x-6 font-mono text-sm">
          {links.live && (
            <li>
              <a
                class="inline-flex min-h-11 items-center text-accent transition-colors hover:text-text"
                href={links.live}
              >
                Live site <span aria-hidden="true">&nbsp;↗</span>
              </a>
            </li>
          )}
          {links.code && (
            <li>
              <a
                class="inline-flex min-h-11 items-center text-accent transition-colors hover:text-text"
                href={links.code}
              >
                Code on GitHub <span aria-hidden="true">&nbsp;↗</span>
              </a>
            </li>
          )}
        </ul>
        {note && <p class="mt-3 text-sm text-muted">{note}</p>}
      </section>
    </article>
  </Container>
</BaseLayout>
