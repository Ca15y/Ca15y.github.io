---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import PipelineStrip from '../../components/PipelineStrip.astro';
import Placeholder from '../../components/Placeholder.astro';
---

<BaseLayout title="Colophon" description="How this site is built, tested and deployed.">
  <Container class="py-16 sm:py-20">
    <SectionLabel text="cat colophon.md" />
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">How this site is built</h1>
    <p class="mt-4 max-w-[65ch] text-lg text-muted">
      This site is a DevOps project in its own right. Every pull request runs these gates, and a
      failing gate blocks the deploy.
    </p>
    <div class="mt-8">
      <PipelineStrip />
    </div>
    <div class="mt-12">
      <Placeholder note="Phase 4: full write-up (pipeline diagram, each gate and why, security choices, performance budget, custom domain plan)." />
    </div>
  </Container>
</BaseLayout>
